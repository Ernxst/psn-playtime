{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "treatConfigHintsAsErrors": true,
  // TanStack Start resolves this as the server entry via a virtual module, so
  // there is no static importer for knip to follow.
  "entry": ["src/server.ts"],
  // Vendored shadcn primitives: keep the full component API even when unused.
  "ignore": ["src/components/ui/**"],
  "ignoreDependencies": [
    // Build-tooling / peers that are used but not import-traceable by knip.
    // (`@effect/language-service` is traced via tsconfig.effect.json's
    // `plugins`; `@effect/tsgo`'s `effect-tsgo` bin via the `prepare` script.)
    "@tanstack/router-plugin",
    // Browser-mode runner: enabled via `test.browser` in vitest.config.ts and a
    // peer of `@vitest/browser-playwright`, but not statically imported. Was only
    // trace-resolved through `@vitest/coverage-v8`'s peer graph before its removal.
    "@vitest/browser",
    "seroval",
    "seroval-plugins",
    "oxlint-plugin-react-doctor",
  ],
}
