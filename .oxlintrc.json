{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./tools/oxlint/test-contract.json"],
  "plugins": ["react", "typescript", "unicorn", "oxc", "jsx-a11y", "jsdoc", "unicorn", "vitest"],
  "jsPlugins": [
    "oxlint-plugin-complexity",
    "./tools/oxlint/test-contract.mjs",
    {
      "name": "vitest-format",
      "specifier": "@vitest/eslint-plugin"
    }
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/components/ui/**",
    ".output",
    ".nitro",
    "dist",
    "node_modules"
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "no-extra-boolean-cast": "error",
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 4],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity/complexity": [
      "error",
      {
        "cyclomatic": 5,
        "cognitive": 6
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "fix": {
          "imports": "fix",
          "variables": "off"
        }
      }
    ]
  },
  "overrides": [
    {
      "files": ["tools/oxlint/*.mjs"],
      "rules": {
        "typescript/no-unsafe-assignment": "off",
        "complexity/complexity": "off"
      }
    }
  ]
}
