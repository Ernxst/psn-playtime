{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "jsx-a11y", "jsdoc", "unicorn", "vitest"],
  "jsPlugins": ["oxlint-plugin-complexity"],
  "env": {
    "browser": true,
    "es2024": true
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/components/ui/**",
    ".output",
    ".nitro",
    "dist",
    "node_modules"
  ],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "no-extra-boolean-cast": "error",
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 3],
    "max-params": ["error", 4],
    "eslint/max-lines-per-function": [
      "error",
      {
        "max": 40,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "complexity/complexity": [
      "error",
      {
        "cyclomatic": 5,
        "cognitive": 6
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "fix": {
          "imports": "fix",
          "variables": "off"
        }
      }
    ]
  },
  "overrides": [
    {
      // Shared test file overrides — framework-specific test rules
      // are in separate jest/ and vitest/ configs to avoid conflicts.
      "files": ["**/*.{test,spec}.{ts,tsx,js,jsx}", "**/__tests__/**/*.{ts,tsx,js,jsx}"],
      "rules": {
        // Disabled: mock callbacks often need empty functions
        "no-empty-function": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/no-standalone-expect": "off", // breaks when you use test.extend
        "vitest/no-conditional-expect": "error",
        "vitest/no-conditional-tests": "error",
        "vitest/prefer-each": "error",
        "vitest/prefer-expect-resolves": "error",
        "vitest/prefer-called-times": "error",
        "vitest/prefer-called-exactly-once-with": "error",
        "vitest/no-restricted-matchers": [
          "error",
          {
            "toBeTruthy": "Assert the exact value",
            "toBeFalsy": "Assert the exact value",
            "toHaveBeenCalled": "Assert the exact call count"
          }
        ],
        "eslint/max-lines-per-function": "off",
        "complexity/complexity": "off",
        "max-nested-callbacks": "off"
      }
    }
  ]
}
